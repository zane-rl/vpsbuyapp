# 数据库（SQLite 文件路径，相对 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# 管理后台登录密码（请改成强密码）
ADMIN_PASSWORD="change-me-please"

# 会话签名密钥（请用随机长字符串，例如 `openssl rand -hex 32`）
SESSION_SECRET="please-generate-a-long-random-secret"

# 监听端口（可选，默认 3000）。生产用 npm run start 时生效。
PORT=3000

# 到期推送定时任务端点的调用凭证（openssl rand -hex 16 生成）
# 未配置时 /api/cron/expiry-notify 直接返回 503，推送功能不可用
CRON_SECRET="please-generate-a-random-secret"
